NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI-assisted CV extraction. Leave blank until whoever handles POPIA has read
# Groq's data processing terms and said yes: with this set, every CV that is
# not on the TiPP Focus template is sent to Groq's servers in the United
# States, with email, phone and ID numbers stripped first. Each one is
# recorded in the audit trail. Blank means nothing leaves and the local
# parser does all the work, exactly as before.
GROQ_API_KEY=

# AI-assisted tender extraction. With this set, every uploaded tender
# document (RFP, RFQ, RFI) is sent to Google's Gemini API, as the PDF itself
# where it is one, and read in full: the roles to staff with their own years,
# skills and certifications, the dates, the value, the client. Each send is
# recorded in the audit trail. The free tier's terms let Google use what is
# sent to improve its models, which is fine for a public procurement notice
# and not for a confidential client document. Blank means nothing leaves and
# the local parser does all the work. GEMINI_MODEL names the model, or a
# comma-separated chain tried in order when one is out of quota, retired
# or overloaded; the default chain is
# gemini-3.6-flash,gemini-3.7-flash,gemini-3.5-flash-lite. The free tier
# allows each model twenty requests a day. GEMINI_THINKING sets how hard
# the model thinks (low, the default, reads a document well and fast).
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_THINKING=

# With a key set the app sends its own mail: invitations to new accounts,
# password resets and match alerts. Without one, invitations are handed
# over by the admin and resets go through Supabase's own mailer, which
# only delivers to the project's team. RESEND_FROM must be a sender on a
# domain verified in Resend, e.g. "Resource Planning <planning@tippfocus.co.za>";
# the fallback test sender delivers only to the Resend account's own address.
RESEND_API_KEY=
RESEND_FROM=

NEXT_PUBLIC_APP_URL=http://localhost:3000
