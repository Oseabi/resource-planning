NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI-assisted CV extraction. Leave blank until whoever handles POPIA has read
# Groq's data processing terms and said yes: with this set, every CV that is
# not on the TiPP Focus template is sent to Groq's servers in the United
# States, with email, phone and ID numbers stripped first. Each one is
# recorded in the audit trail. Blank means nothing leaves and the local
# parser does all the work, exactly as before.
GROQ_API_KEY=

# AI-assisted tender extraction. With this set, every uploaded tender
# document (RFP, RFQ, RFI) is sent to Google's Gemini API, as the PDF itself
# where it is one, and read in full: the roles to staff with their own years,
# skills and certifications, the dates, the value, the client. Each send is
# recorded in the audit trail. The free tier's terms let Google use what is
# sent to improve its models, which is fine for a public procurement notice
# and not for a confidential client document. Blank means nothing leaves and
# the local parser does all the work. GEMINI_MODEL picks the model; the
# default is gemini-2.5-flash.
GEMINI_API_KEY=
GEMINI_MODEL=

RESEND_API_KEY=
# Verified sender, e.g. "Resource Planning <alerts@yourdomain.com>". Falls back to Resend's test sender.
RESEND_FROM=

NEXT_PUBLIC_APP_URL=http://localhost:3000
